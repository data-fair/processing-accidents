{
  "name": "@data-fair/processing-accidents",
  "version": "0.2.8",
  "description": "Load the French road accidents database (BAAC) and keep the accidents involving a bicycle",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepare": "husky || true",
    "build-types": "export NODE_OPTIONS='--experimental-strip-types' && df-build-types ./config && df-build-types ./types",
    "test-base": "NODE_ENV=test node --experimental-strip-types --test-force-exit --test-concurrency=1 --test --test-reporter=spec --test-reporter-destination=stdout",
    "test": "npm run test-base test-it/*.ts"
  },
  "imports": {
    "#config": "./lib/config.ts",
    "#types/*": "./types/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/data-fair/processing-accidents.git"
  },
  "keywords": [
    "data-fair-processings-plugin"
  ],
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/data-fair/processing-accidents/issues"
  },
  "homepage": "https://github.com/data-fair/processing-accidents#readme",
  "dependencies": {
    "csv-parser": "^3.0.0",
    "form-data": "^4.0.0",
    "fs-extra": "^11.1.1",
    "iconv-lite": "^0.6.3",
    "json-2-csv": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@data-fair/lib-common-types": "^1.21.0",
    "@data-fair/lib-processing-dev": "^0.3.0",
    "@data-fair/lib-types-builder": "^1.14.0",
    "@data-fair/lib-utils": "^1.11.0",
    "@types/fs-extra": "^11.0.4",
    "axios": "^1.7.9",
    "config": "^4.4.1",
    "debug": "^4.4.0",
    "eslint": "^9.26.0",
    "husky": "^9.1.7",
    "neostandard": "^0.12.1",
    "typescript": "^5.8.3",
    "ws": "^8.19.0"
  },
  "files": [
    "processing-config-schema.json",
    "./lib/**/*"
  ]
}
